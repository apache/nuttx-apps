#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_NIMBLE_BLEESS
	tristate "NimBLE Environmental Sensing peripheral"
	default n
	depends on NIMBLE && NIMBLE_ROLE_PERIPHERAL
	---help---
		Enable the NimBLE Environmental Sensing peripheral example.

if EXAMPLES_NIMBLE_BLEESS

config EXAMPLES_NIMBLE_BLEESS_PROGNAME
	string "Program name"
	default "bleess"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_NIMBLE_BLEESS_PRIORITY
	int "NimBLE task priority"
	default 100

config EXAMPLES_NIMBLE_BLEESS_STACKSIZE
	int "NimBLE stack size"
	default DEFAULT_TASK_STACKSIZE

endif # EXAMPLES_NIMBLE_BLEESS
