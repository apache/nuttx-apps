config EXAMPLES_NIMBLE_MESH_NODE
	tristate "NimBLE Mesh Generic OnOff node example"
	default n
	depends on NIMBLE_MESH
	---help---
		Provisionable NimBLE Mesh node with a Generic OnOff Server.

if EXAMPLES_NIMBLE_MESH_NODE

