config EXAMPLES_NIMBLE_MESH_SENSOR
	tristate "NimBLE Mesh Sensor Server node example"
	default n
	depends on NIMBLE_MESH
	---help---
		Provisionable NimBLE Mesh node with a Sensor Server model.

if EXAMPLES_NIMBLE_MESH_SENSOR

config EXAMPLES_NIMBLE_MESH_SENSOR_PROGNAME
	string "Program name"
	default "nimble_mesh_sensor"

config EXAMPLES_NIMBLE_MESH_SENSOR_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_NIMBLE_MESH_SENSOR_STACKSIZE
	int "Stack size"
	default 4096

endif
