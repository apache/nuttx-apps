config EXAMPLES_NIMBLE_MESH_SENSOR
	tristate "NimBLE Mesh Sensor Server node example"
	default n
	depends on NIMBLE_MESH
	---help---
		Provisionable NimBLE Mesh node with a Sensor Server model.

if EXAMPLES_NIMBLE_MESH_SENSOR

