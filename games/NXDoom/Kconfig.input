choice # Input method
	prompt "NXDoom input method"
	default GAMES_NXDOOM_KEYBOARD

	config GAMES_NXDOOM_KEYBOARD
		bool "Keyboard"
		---help---
			Use a NuttX keyboard character driver.

endchoice # Input method

if GAMES_NXDOOM_KEYBOARD

config GAMES_NXDOOM_UARTKBD
	bool "Keys from a serial terminal"
	default n
	---help---
		Read the keys from a serial terminal instead of a keyboard driver.
		KBDPATH then names a tty, such as /dev/console.  A terminal reports
		a key press only, so each press is released again once the terminal
		stops repeating it.  WASD or the arrow keys move, J fires, K runs,
		L strafes, E or space uses, Q or Esc opens the menu.

config GAMES_NXDOOM_KBDPATH
	string "Keyboard device path"
	default "/dev/kbd0"
	---help---
		Path to the keyboard device to use as input.

endif # GAMES_NXDOOM_KEYBOARD
