 	main_argv = (char **) argv;
+#if defined(DUK_CMDLINE_SIGNAL)
+	g_interrupted = 0;
+#endif
 
 #if defined(EMSCRIPTEN)
 	/* Try to use NODEFS to provide access to local files.  Mount the
@@ -1509,6 +1534,12 @@ int main(int argc, char *argv[]) {
 		fflush(stderr);
 	}
 
+#if defined(DUK_CMDLINE_SIGNAL)
+	if (g_interrupted) {
+		retval = 130;
+	}
+#endif
+
 	if (ctx && no_heap_destroy) {
 		duk_gc(ctx, 0);
 	}

