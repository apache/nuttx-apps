#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config SYSTEM_BRCTL
	tristate "Ethernet bridge 'brctl' command"
	default n
	depends on NET_BRIDGE
	---help---
		Enable the 'brctl' command to create Ethernet bridges and to add or
		remove their ports.

if SYSTEM_BRCTL

config SYSTEM_BRCTL_PROGNAME
	string "brctl program name"
	default "brctl"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config SYSTEM_BRCTL_PRIORITY
	int "brctl task priority"
	default 100

config SYSTEM_BRCTL_STACKSIZE
	int "brctl stack size"
	default DEFAULT_TASK_STACKSIZE

endif
