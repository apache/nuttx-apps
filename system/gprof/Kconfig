config SYSTEM_GPROF
	tristate "gprof tool"
	default n
	depends on !PROFILE_NONE || SIM_GPROF
	---help---
		Enable support for the 'gprof' command.

if SYSTEM_GPROF

config SYSTEM_GPROF_PRIORITY
	int "gprof task priority"
	default 100

config SYSTEM_GPROF_STACKSIZE
	int "gprof stack size"
	default DEFAULT_TASK_STACKSIZE

endif
