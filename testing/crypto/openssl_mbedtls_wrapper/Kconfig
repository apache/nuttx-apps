config TESTING_OPENSSL_WRAPPER_MBEDTLS
	tristate "openssl_mbedtls_wrapper cmocka tests"
	default n
	depends on TESTING_CMOCKA
	depends on OPENSSL_MBEDTLS_WRAPPER
	---help---
		Enable cmocka tests for openssl_mbedtls_wrapper

if TESTING_OPENSSL_WRAPPER_MBEDTLS

config TESTING_OPENSSL_WRAPPER_MBEDTLS_PRIORITY
	int "Task priority"
	default 100

config TESTING_OPENSSL_WRAPPER_MBEDTLS_STACKSIZE
	int "Stack size"
	default 32768

config TESTING_OPENSSL_WRAPPER_MBEDTLS_PKCS12
	bool "Enable PKCS12 parse test"
	depends on MBEDTLS_PKCS12_C
	default y
	---help---
		Test d2i_PKCS12, PKCS12_parse, PKCS12_free

endif
