#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTING_TASKWDT
	bool "Task watchdog supervisor test (taskwdt_test)"
	default n
	depends on TASKWDT
	---help---
		Test the task watchdog supervisor (CONFIG_TASKWDT). Run
		"taskwdt_test" without arguments for the list of test cases. The
		cases that must not reset the system print PASS or FAIL, the
		others stop feeding on purpose and expect the system to reset.

if TESTING_TASKWDT

config TESTING_TASKWDT_PROGNAME
	string "Program name"
	default "taskwdt_test"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config TESTING_TASKWDT_PRIORITY
	int "taskwdt_test task priority"
	default 100

config TESTING_TASKWDT_STACKSIZE
	int "taskwdt_test stack size"
	default DEFAULT_TASK_STACKSIZE

endif
