#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTING_LOCALE
	tristate "Locale test"
	default n
	depends on LIBC_LOCALE
	---help---
		Check the locale names that setlocale() and newlocale() accept,
		and, with LIBC_LOCALE_GETTEXT, that gettext() and the other
		<libintl.h> functions do not change errno.

if TESTING_LOCALE

config TESTING_LOCALE_PROGNAME
	string "Program name"
	default "locale_test"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config TESTING_LOCALE_PRIORITY
	int "locale_test task priority"
	default 100

config TESTING_LOCALE_STACKSIZE
	int "locale_test stack size"
	default DEFAULT_TASK_STACKSIZE

endif
