config TESTING_LSEARCH
	tristate "lfind(), lsearch(), insque() and remque() test"
	default n
	---help---
		Check lfind() and lsearch() of <search.h>, and insque() and
		remque() on a linear and on a circular queue.

if TESTING_LSEARCH

config TESTING_LSEARCH_PROGNAME
	string "Program name"
	default "lsearch_test"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config TESTING_LSEARCH_PRIORITY
	int "lsearch_test task priority"
	default 100

config TESTING_LSEARCH_STACKSIZE
	int "lsearch_test stack size"
	default DEFAULT_TASK_STACKSIZE

endif
