#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTING_MKTEMP
	tristate "mktemp() test"
	default n
	depends on !DISABLE_PTHREAD
	---help---
		Check that mktemp(), mkstemp() and mkdtemp() return an error at
		once when stat() fails with an error other than ENOENT.

if TESTING_MKTEMP

config TESTING_MKTEMP_PROGNAME
	string "Program name"
	default "mktemp_test"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config TESTING_MKTEMP_PRIORITY
	int "mktemp_test task priority"
	default 100

config TESTING_MKTEMP_STACKSIZE
	int "mktemp_test stack size"
	default DEFAULT_TASK_STACKSIZE

endif
