#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTING_PRINTFTEST
	tristate "printf() safety test"
	default n
	---help---
		Test that printf() takes each argument at its right size and stays
		inside its buffers, also for large widths and unknown conversions.

if TESTING_PRINTFTEST

config TESTING_PRINTFTEST_PROGNAME
	string "Program name"
	default "printftest"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config TESTING_PRINTFTEST_PRIORITY
	int "Printftest task priority"
	default 100

config TESTING_PRINTFTEST_STACKSIZE
	int "Printftest stack size"
	default DEFAULT_TASK_STACKSIZE

endif
