config TESTING_GRANTEST
	tristate "Granule allocator test"
	default n
	depends on GRAN && BUILD_FLAT
	---help---
		Test gran_reserve() and gran_alloc_align() of the granule
		allocator.

if TESTING_GRANTEST

config TESTING_GRANTEST_PROGNAME
	string "Program name"
	default "grantest"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config TESTING_GRANTEST_PRIORITY
	int "Task priority"
	default 100

config TESTING_GRANTEST_STACKSIZE
	int "Stack size"
	default DEFAULT_TASK_STACKSIZE

endif
