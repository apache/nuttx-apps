#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTING_NET_TEST
	tristate "vela cmocka net test"
	default n
	depends on TESTING_CMOCKA
	depends on NET
	---help---
		Enable the cmocka net test

if TESTING_NET_TEST

config TESTING_NET_TEST_PRIORITY
	int "Task priority"
	default 100

config TESTING_NET_TEST_STACKSIZE
	int "Stack size"
	default DEFAULT_TASK_STACKSIZE

config TESTING_NET_TCP
	bool "Enable cmocka net tcp test"
	depends on NET_TCP && NET_TCPBACKLOG
	depends on NET_IPv4 || NET_IPv6
	default y

if TESTING_NET_TCP

config TESTING_NET_TCP_PORT
	int "TCP port of test server"
	default 5471

endif

config TESTING_NET_UDP
	bool "Enable cmocka net udp test"
	depends on NET_UDP && !NET_UDP_NO_STACK
	depends on NET_IPv4 && NET_IPv6 && NET_LOOPBACK && NET_SOCKOPTS
	default y
	---help---
		Test UDP sockets of AF_INET and AF_INET6 on one port over the
		loopback device: IPV6_V6ONLY (also on TCP sockets), the delivery
		of IPv4 and IPv6 datagrams, and EADDRINUSE from bind()
		(cmocka_net_udp).

config TESTING_NET_LOCAL
	bool "Enable cmocka net local test"
	depends on NET_LOCAL && NET_LOCAL_SCM
	default y

config TESTING_NET_LOCAL_DGRAM
	bool "Enable cmocka net local datagram test"
	depends on NET_LOCAL && NET_LOCAL_DGRAM
	depends on !DISABLE_PTHREAD && !DISABLE_POSIX_TIMERS
	default y
	---help---
		Test connect(), send(), getpeername(), poll(), select() and epoll
		of Unix domain datagram sockets, and that POLLHUP of pipes and
		stream sockets stays (cmocka_net_local_dgram).  The first optional
		argument of the program is a writable directory for the socket
		names (default P_tmpdir).  The second is a cmocka filter, to run
		some of the cases.

config TESTING_NET_OTHERS
	bool "Enable cmocka net other test"
	default y

config TESTING_NET_MCAST
	bool "Enable cmocka net multicast test"
	depends on NET_UDP && !NET_UDP_NO_STACK
	depends on NET_SOCKOPTS && NET_LOOPBACK
	depends on NET_IGMP || NET_MLD
	default y

config TESTING_NET_RADIO
	bool "Enable cmocka net radio socket test"
	depends on NET_BLUETOOTH || NET_IEEE802154
	default y
	---help---
		Test that recvfrom() on a Bluetooth or IEEE 802.15.4 socket with
		no radio device fails with ENODEV and leaves the socket usable
		(cmocka_net_radio).

config TESTING_NET_TIMESTAMP
	bool "Enable cmocka net timestamp test"
	depends on NET_TIMESTAMP && NET_PKT
	default n

endif
