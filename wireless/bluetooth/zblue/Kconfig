#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig ZBLUE
	bool "zblue: Zephyr Bluetooth host"
	default n
	depends on ARCH_SIM
	depends on TLS_NELEM > 0
	depends on !WIRELESS_BLUETOOTH_HOST && !NIMBLE
	depends on UART_BTH4
	select CRYPTO_MBEDTLS
	select MBEDTLS_AES_C
	select MBEDTLS_CIPHER_C
	select MBEDTLS_CMAC_C
	select MBEDTLS_ECP_C
	select MBEDTLS_ECDH_C
	select MBEDTLS_ECP_DP_SECP256R1_ENABLED
	select MBEDTLS_MD5_C
	select MBEDTLS_PSA_CRYPTO_C
	select MBEDTLS_CTR_DRBG_C
	select MBEDTLS_ENTROPY_C
	select MBEDTLS_SHA256_C
	select MBEDTLS_PLATFORM_C
	---help---
		The Bluetooth host of the Zephyr project, run unmodified in
		userspace on top of a small porting layer.  The source is
		downloaded from the Zephyr release given by ZBLUE_REF.

		Only the simulator is supported for now: initialized data in
		iterable RAM sections (net_buf pools) is not yet placed in .data
		by the board linker scripts.

		The Bluetooth features are configured with the original
		Zephyr CONFIG_BT_* options, in the file given by ZBLUE_CONF.
		They are resolved by the Zephyr Kconfig after download and do
		not appear in this menu.

		The controller is reached through /dev/ttyHCIx (UART_BTH4),
		so any NuttX driver registered with bt_driver_register() can
		be used.

if ZBLUE

config ZBLUE_REF
	string "Zephyr release"
	default "v4.5.0"
	---help---
		Zephyr git tag to download the Bluetooth host from.

config ZBLUE_CONF
	string "Zephyr Bluetooth configuration"
	default "zblue.conf"
	---help---
		Zephyr style configuration fragment with the CONFIG_BT_*
		options.  A relative path is relative to this directory.

config ZBLUE_HCI_DEVICE
	string "HCI device"
	default "/dev/ttyHCI0"

config ZBLUE_HCI_RX_STACKSIZE
	int "HCI RX thread stack size"
	default 2048

config ZBLUE_THREAD_PRIORITY
	int "Base priority of the Bluetooth threads"
	default 120
	---help---
		Zephyr cooperative priorities are mapped below this value,
		preemptive priorities above it.

config ZBLUE_PERIPHERAL_EXAMPLE
	tristate "Peripheral example"
	default n
	---help---
		"zblue_peripheral": advertise and accept connections, with
		the GAP and GATT services only.

endif # ZBLUE
